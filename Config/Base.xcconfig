// Shared, non-secret build settings. Secrets live in Secrets.xcconfig (gitignored).

// Defaults so the app builds and launches even before any keys are configured.
// Empty keys make the app show "Google Maps unavailable" / straight-line route estimates
// instead of crashing.
GOOGLE_MAPS_API_KEY =
GOOGLE_ROUTES_API_KEY =
GOOGLE_ARCORE_API_KEY =

// "routes" (Google Routes API, default — required for Cloud projects created after 2025-03-01)
// or "legacy" (Directions API, only for projects that still have it enabled).
DIRECTIONS_PROVIDER = routes

// Request ARCore Geospatial by default now that ARCoreGeospatial is linked in project.yml.
// Runtime must still gate on Google data-processing consent, an authorized API key,
// full-accuracy location permission, device support, and network availability.
// Keep the existing Apple Core Location / ARKit fallback whenever any check fails.
// A local Secrets.xcconfig can explicitly override this setting to 0 if needed.
ENABLE_ARCORE_GEOSPATIAL = 1

// Extra Swift compilation conditions derived from the flags above are applied in Debug/Release.xcconfig.
APP_COMPILATION_CONDITIONS =

// Your Apple Developer Team ID for automatic signing (leave empty for simulator-only builds).
DEVELOPMENT_TEAM =
