// Copy this file to Config/Secrets.xcconfig (gitignored) and fill in your values.
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Create keys in Google Cloud Console -> APIs & Services -> Credentials.
// Recommended: two keys.
//   1. iOS-app-restricted key (bundle id com.cranford.historicalar) with API restriction "Maps SDK for iOS".
//   2. Key with API restriction "Routes API" (and "ARCore API" if you enable Geospatial).
// You may use one key for both during development.

GOOGLE_MAPS_API_KEY = AIza...your-maps-sdk-key...
GOOGLE_ROUTES_API_KEY = AIza...your-routes-api-key...
GOOGLE_ARCORE_API_KEY = AIza...your-arcore-api-key...

// routes | legacy
DIRECTIONS_PROVIDER = routes

// 0 | 1  — request ARCore Geospatial at runtime (package is linked; still needs this flag,
// an ARCore API key, precise location, network, and first-run consent).
ENABLE_ARCORE_GEOSPATIAL = 0

// Apple Developer Team ID (10 characters) for running on a physical device.
DEVELOPMENT_TEAM = ABCDE12345
